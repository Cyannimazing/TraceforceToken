# Application origin. Use the public HTTPS origin when deploying.
SITE_URL=http://localhost:3000

# Search indexing is opt-in; preview deployments remain noindex.
ALLOW_INDEXING=false

# MySQL 8.0.16+ or a compatible MariaDB version with enforced CHECK constraints.
# Copy this file to .env.local and replace these example values before database use.
# Percent-encode reserved characters in the username/password. Do not add URI query options.
DATABASE_URL=mysql://traceforge_user:replace_me@127.0.0.1:3306/traceforge

# Local MySQL can use false. Hosted production databases should use verified TLS.
# If omitted, remote hosts default to verified TLS; localhost defaults to false.
# DATABASE_SSL=false is rejected for remote hosts. Use a local secure tunnel if needed.
DATABASE_SSL=true

# Optional PEM CA supplied by your database provider; literal \n is supported.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Connections per application instance; deployment-wide usage also depends on instance count.
DATABASE_POOL_SIZE=5

# Separate schema credentials; migrations prefer this when provided.
# DATABASE_MIGRATION_URL=mysql://traceforge_migration:replace_me@127.0.0.1:3306/traceforge
# Disposable local integration database, created by npm run db:setup:local.
# TEST_DATABASE_URL=mysql://traceforge_test:replace_me@127.0.0.1:3306/traceforge_test_jobs

# Generate a random 32+ character value. Never publish it.
# Signs anonymous visitor sessions and scan chat context. Rotation invalidates both.
# Local setup generates this directly into ignored .env.local.
RATE_LIMIT_SECRET=
# On Vercel, configure the protected VPS engine; local development runs directly.
# No token parameters, reports, evidence, or chat history are stored in MySQL.
# SCAN_ENGINE_URL=https://your-engine.example/scan
# SCAN_ENGINE_SECRET=your-separate-random-32-character-secret

# Approved Base mainnet RPC. Public RPC is suitable for bounded local validation.
# For sustained usage configure your Alchemy or other approved provider endpoint.
BASE_RPC_URL=https://mainnet.base.org
# Explicit keyless availability fallback; same-chain/pinned-header checks precede reuse.
# Public endpoints have shared limits. This does not provide full indexed history.
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com,https://base.drpc.org
# Explicit independent log discovery; receipt/state reads stay on BASE_RPC_URL.
# This approved endpoint is engine-only; requests share the same scan budget.
BASE_LOG_RPC_URL=https://base-rpc.publicnode.com
# Full token history is the default public scan scope. RPC discovery reads from
# Base genesis; only completely processed ranges count as completed coverage.
# For efficient paginated full token and inbound native history, configure your
# own Base Alchemy API URL and explicitly select the indexed adapters below.
# Alchemy offers a free account with Transfers API access; an API key does not
# imply a paid subscription. Check the account's current usage/range limits.
# The index is discovery only: amounts and inclusion come from pinned RPC proofs.
# BASE_ALCHEMY_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_PRIVATE_API_KEY
BASE_TRANSFER_SOURCE=rpc
# With the private API URL configured, set BASE_TRANSFER_SOURCE=alchemy and
# BASE_FUNDING_SOURCE=alchemy. Keep the URL only on the protected scan engine.
# PublicNode log access and dRPC state/receipt access were checked separately.
# dRPC's public plan does not provide free eth_getLogs; fallback is availability recovery.
# rpc uses configured Blockscout indexing when available, otherwise bounded full blocks.
# alchemy reads paginated top-level inbound native history over the requested range.
# sqd-public-testing is explicit local evaluation only; review SQD access terms before hosting.
BASE_FUNDING_SOURCE=rpc
# BASE_RPC_ALLOWED_HOSTS=your-approved-provider.example
# Optional operator key for indexed funding and authenticated holder discovery.
# Blockscout PRO also offers a free tier; "PRO" is the API product name.
# BLOCKSCOUT_API_KEY=
# Without a Blockscout key, GoPlus supplies reported counts and Top10 candidates.
# Balances still require exact pinned RPC reads; the list is not a holder census.
# Optional server-only token for applicable GoPlus operator API access/limits.
# GOPLUS_ACCESS_TOKEN=
# Empty historical ranges can be wide. Explicit range/result limits halve chunks;
# outages, throttles and forbidden access never trigger repeated range shrinking.
# Increase/decrease for your provider. Indexed Alchemy transfers skip log chunking.
BASE_RPC_LOG_CHUNK_SIZE=1000000
BASE_RPC_CALL_BUDGET=500
BASE_MAX_TRANSFER_LOGS=2000
BASE_FUNDING_MAX_PAGES=10
BASE_NATIVE_FUNDING_MAX_BLOCKS=32
BASE_PROVIDER_TIMEOUT_MS=12000
BASE_PROVIDER_SCAN_TIMEOUT_MS=120000

# Every completed report requires actual configured-provider investigator review.
# Start Ollama with cloud disabled; install the reviewed base and create the named model.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=traceforce-investigator
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_MAX_RESPONSE_BYTES=65536
LOCAL_AI_MAX_CONTEXT_BYTES=8000
LOCAL_AI_MAX_EVIDENCE_RECORDS=12
LOCAL_AI_MAX_OUTPUT_TOKENS=800
LOCAL_AI_CONTEXT_TOKENS=4096
LOCAL_AI_THREADS=2
LOCAL_AI_GPU_LAYERS=0

# Optional server-only Gemini fallback. Keep the key on the local/protected engine.
# Local inference is preferred; unavailable/deadline errors may use Gemini.
# With no local model configured, a valid Gemini key enables direct inference.
LOCAL_AI_KEEP_ALIVE_SECONDS=300
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
