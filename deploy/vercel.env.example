# Server environment inventory only; never commit the filled copy.
# Set these separately for the intended Vercel project/environment.
# The intentionally blank settings fail the offline deployment preflight.
SITE_URL=
ALLOW_INDEXING=false
SCAN_ENGINE_URL=
SCAN_ENGINE_SECRET=
RATE_LIMIT_SECRET=
DATABASE_URL=
DATABASE_SSL=true
# Only the public issuing CA certificate, when needed; escaped newlines supported.
# DATABASE_CA_CERT=
DATABASE_POOL_SIZE=2
# No provider/Ollama, migration/test/cron, or NEXT_PUBLIC secret settings here.
