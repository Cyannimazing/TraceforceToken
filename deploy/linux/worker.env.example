# systemd EnvironmentFile syntax. Copy to /etc/traceforce/worker.env, root:root 0600.
# Historical filename; this now configures the stateless HTTP scan engine.
# No database, migration, queue, report-storage, or browser credentials belong here.
SCAN_ENGINE_PORT=8787
# Required: generate a private random value and configure the identical secret in Vercel.
# Leave blank in this template so an unchanged copy cannot start with a published secret.
SCAN_ENGINE_SECRET=
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_URLS=https://base-rpc.publicnode.com,https://base.drpc.org
# Independent log discovery; pinned receipt/state verification uses the RPC lane.
BASE_LOG_RPC_URL=https://base-rpc.publicnode.com
BASE_FUNDING_SOURCE=rpc
BASE_TRANSFER_SOURCE=rpc
# Efficient indexed full-history discovery, verified against the state RPC:
# BASE_ALCHEMY_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_PRIVATE_API_KEY
# With the above URL configured, set both acquisition sources to alchemy.
# BASE_RPC_ALLOWED_HOSTS=your-reviewed-provider.example
# Optional operator indexer key for funding and authenticated holder discovery.
# Without it, funding uses bounded full blocks; GoPlus supplies reported holder
# counts and Top10 candidates, whose balances still require pinned RPC reads.
# BLOCKSCOUT_API_KEY=replace_me_if_indexed_discovery_is_enabled
# Optional server-only GoPlus operator access token; review access/license terms.
# GOPLUS_ACCESS_TOKEN=
# Provider-specific range/body limits still apply; reduce this if required.
BASE_RPC_LOG_CHUNK_SIZE=1000000
BASE_RPC_CALL_BUDGET=500
BASE_MAX_TRANSFER_LOGS=2000
BASE_FUNDING_MAX_PAGES=10
BASE_NATIVE_FUNDING_MAX_BLOCKS=32
BASE_PROVIDER_TIMEOUT_MS=12000
BASE_PROVIDER_SCAN_TIMEOUT_MS=120000
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=traceforce-investigator
LOCAL_AI_TIMEOUT_MS=120000
LOCAL_AI_MAX_RESPONSE_BYTES=65536
LOCAL_AI_MAX_CONTEXT_BYTES=8000
LOCAL_AI_MAX_EVIDENCE_RECORDS=12
LOCAL_AI_MAX_OUTPUT_TOKENS=800
LOCAL_AI_CONTEXT_TOKENS=4096
LOCAL_AI_THREADS=2
LOCAL_AI_GPU_LAYERS=0

# Optional server-only Gemini fallback. Keep the key on the local/protected engine.
# Local inference is preferred; unavailable/deadline errors may use Gemini.
# With no local model configured, a valid Gemini key enables direct inference.
LOCAL_AI_KEEP_ALIVE_SECONDS=300
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
