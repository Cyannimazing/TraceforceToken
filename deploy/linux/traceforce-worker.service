[Unit]
Description=TraceForce Engine private stateless scan service
Wants=network-online.target traceforce-ollama.service
After=network-online.target traceforce-ollama.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=traceforce
Group=traceforce
WorkingDirectory=/opt/traceforce/current
EnvironmentFile=/etc/traceforce/worker.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
UnsetEnvironment=DATABASE_URL DATABASE_CA_CERT DATABASE_SSL DATABASE_POOL_SIZE DATABASE_MIGRATION_URL TEST_DATABASE_URL CRON_SECRET RATE_LIMIT_SECRET
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/scan-engine.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
CPUAccounting=true
CPUQuota=25%
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
TasksMax=64
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
