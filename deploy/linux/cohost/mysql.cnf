# MySQL Community 8.4 only. Review before explicit installation.
# /etc/mysql/mysql.conf.d/zz-traceforce-cohost.cnf
[mysqld]
# Initial state is local-only. Add one actual interface IP only AFTER TLS,
# least-privilege accounts, and both source-IP firewalls have been verified.
# Example shape: bind_address=127.0.0.1,ACTUAL_INTERFACE_IP
bind_address=127.0.0.1
port=3306
skip_name_resolve=ON
mysqlx=0

require_secure_transport=ON
tls_version=TLSv1.2,TLSv1.3
ssl_ca=/etc/mysql/tls/ca.pem
ssl_cert=/etc/mysql/tls/server-cert.pem
ssl_key=/etc/mysql/tls/server-key.pem
local_infile=OFF
secure_file_priv=NULL

# Explicit sizes: this is a cohost, not a dedicated database server.
innodb_dedicated_server=OFF
innodb_buffer_pool_size=256M
innodb_log_buffer_size=16M
innodb_redo_log_capacity=64M
max_connections=20
thread_cache_size=4
table_open_cache=256
table_definition_cache=400
temptable_max_ram=32M
temptable_max_mmap=0
tmp_table_size=8M
max_heap_table_size=8M
sort_buffer_size=256K
join_buffer_size=256K
read_buffer_size=128K
read_rnd_buffer_size=256K
net_buffer_length=16K
max_allowed_packet=16M
connect_timeout=5
wait_timeout=30
interactive_timeout=300

# Reduce automatic instrumentation memory; use OS/cgroup counters and limited
# SHOW STATUS diagnostics. Revisit only after measuring the full host budget.
performance_schema=OFF

# No query/body history or replication is required by anonymous quota storage.
general_log=OFF
slow_query_log=OFF
skip_log_bin
